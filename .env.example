# Copia este fichero a .env y ajusta lo que necesites — todas las variables
# tienen un valor por defecto razonable salvo que se indique lo contrario.
#   cp .env.example .env

# Puerto donde escucha el panel web (dentro y fuera del contenedor).
NYXLAUNCHER_PANEL_PORT=8791

# Solo se usa con el servicio "nyxlauncher-portrange" del docker-compose.yml
# (Docker Desktop en Mac/Windows) — rango de puertos publicado para los
# servidores de Minecraft que crees. El launcher sugiere el siguiente puerto
# libre del rango al crear un servidor nuevo; sigue siendo editable a mano.
NYXLAUNCHER_PORT_RANGE_START=25500
NYXLAUNCHER_PORT_RANGE_END=25600

# Clave de cifrado (AES-256-GCM) para los secretos del acceso remoto
# (contraseña, TOTP, tokens de Cloudflare/Resend). Déjalo vacío la primera
# vez: se genera una clave aleatoria automáticamente y se guarda en
# ./nyxlauncher-data/secret.key — solo hace falta fijarla a mano aquí si
# quieres poder mover el volumen de datos a otra máquina de forma
# predecible, o si restauras un backup del volumen sin ese fichero.
# Formato: 32 bytes en hex (64 caracteres) o base64.
NYXLAUNCHER_SECRET_KEY=

# Opcional: crea la cuenta de administrador del panel (usuario + contraseña)
# de forma no interactiva en el primer arranque, sin pasar por la pantalla
# web de configuración inicial. Si dejas cualquiera de las dos vacía, no pasa
# nada — simplemente completas el formulario de "Configura el acceso remoto"
# la primera vez que abras el panel en el navegador. Solo crea la cuenta si
# no existe ya una — nunca sobreescribe una cuenta existente.
NYXLAUNCHER_ADMIN_USERNAME=
NYXLAUNCHER_ADMIN_PASSWORD=

# Solo si usas el sidecar de Tailscale (servicio "tailscale" comentado en
# docker-compose.yml, modo rango de puertos) — clave de autenticación de tu
# cuenta de Tailscale (https://login.tailscale.com/admin/settings/keys).
TS_AUTHKEY=
